{
  "mcpServers": {
    "n8n-mcp": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run", "-p", "verta", "-c", "prd", "--",
        "npx", "-y", "mcp-remote@latest",
        "https://n8n.baseverta.com.br/mcp-server/http",
        "--header", "Authorization:${N8N_AUTH}"
      ]
    },
    "supabase": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run", "-p", "verta", "-c", "prd", "--",
        "npx", "-y", "@supabase/mcp-server-supabase@latest",
        "--project-ref=vnqsyngphmkgvribtmfa"
      ]
    },
    "resend": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run", "-p", "verta", "-c", "prd", "--",
        "npx", "-y", "resend-mcp"
      ]
    },
    "cal": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run", "-p", "verta", "-c", "prd", "--",
        "npx", "@calcom/cal-mcp@latest"
      ]
    },
    "tally": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run", "-p", "verta", "-c", "prd", "--",
        "npx", "-y", "mcp-remote@latest",
        "https://api.tally.so/mcp",
        "--header", "Authorization:${TALLY_AUTH}"
      ]
    },
    "pipedrive": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run", "-p", "verta", "-c", "prd", "--",
        "npx", "-y", "@ckalima/pipedrive-mcp-server"
      ]
    }
  }
}
