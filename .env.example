# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" (adicione-o ao .gitignore).

# --- Domínio ---
N8N_HOST=n8n.baseverta.com.br
SSL_EMAIL=seu-email@baseverta.com.br

# --- PostgreSQL ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica
POSTGRES_DB=n8n

# --- n8n ---
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-de-32-bytes
