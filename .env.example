# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" — o .gitignore já o cobre, junto de
# *.key, *.pem e acme.json (ARQUITETURA.md, seção 6).
#
# Este arquivo lista apenas NOMES de variável. Nenhum valor real entra aqui.
# Serve como checklist de provisionamento: variável ausente no container
# derruba o workflow em runtime, não no deploy.

# =============================================================
# INFRAESTRUTURA — consumidas pelo docker-compose.yml
# =============================================================

# --- Domínio ---
N8N_HOST=n8n.baseverta.com.br
SSL_EMAIL=seu-email@baseverta.com.br

# --- PostgreSQL interno do n8n (rede `internal`, sem saída) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica
POSTGRES_DB=n8n

# --- n8n ---
# Gere com: openssl rand -hex 32
# ATENÇÃO: guarde no cofre como VERTA / <cliente> / N8N_ENCRYPTION_KEY ANTES
# do primeiro deploy. Backup sem esta chave devolve credenciais ilegíveis
# e inviabiliza a portabilidade prometida (ARQUITETURA.md, seção 4.3).
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-de-32-bytes

# Sem barra no final — barra final quebra o roteador Express do n8n.
WEBHOOK_URL=https://n8n.baseverta.com.br
N8N_EDITOR_BASE_URL=https://n8n.baseverta.com.br

# Exigidas pelos Code Nodes:
# - crypto para validação de assinatura de webhook
# - acesso a $env para ler segredo sem hardcode (DECISOES.md, seção 1)
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=

# =============================================================
# SUPABASE — fonte da verdade (ARQUITETURA.md, seção 1)
# Um Project por cliente, nunca separação por schema.
# =============================================================
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Connection string completa (Settings > Database > URI). Necessária para DDL;
# a secret key não cria tabela, só opera sobre tabelas existentes.
SUPABASE_DB_URL=

# =============================================================
# PIPEDRIVE — espelho humano, nunca dita regra para a automação
# =============================================================
# Header x-api-token. A v2 descontinuou ?api_token=.
PIPEDRIVE_API_TOKEN=

# Basic Auth da subscrição de webhook. O Pipedrive NÃO assina webhooks
# (não há HMAC) — Basic Auth é a única proteção oferecida.
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASS=

# IDs e chaves opacas NÃO entram aqui: vivem em pipedrive_config no Supabase.

# =============================================================
# DISCORD — canal único de alerta e transbordo
# Telegram foi descontinuado nesta função (DECISOES.md, seção 2).
# Um webhook por domínio: alerta de infra não se mistura com prospecção.
# =============================================================
DISCORD_WEBHOOK_CADENCIA=
DISCORD_WEBHOOK_ALERTAS=
DISCORD_WEBHOOK_TRANSBORDO=

# =============================================================
# INTERRUPTORES DE COMPORTAMENTO
# =============================================================
# "true" habilita o único ponto em que um workflow marca negócio como
# perdido (WEB - Pipedrive - AvancarCadencia, ramo do T6). Em "false",
# só esse ramo para; o resto do workflow segue funcionando.
CADENCIA_MARCAR_PERDIDO=false

# =============================================================
# INTEGRAÇÕES DE APOIO
# =============================================================
TYPEFORM_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_API_KEY=

# Embeddings self-hosted (BGE-M3 na rede `internal`), substituindo API
# externa para eliminar rate limit (DECISOES.md, seção 1).
EMBEDDINGS_INTERNAL_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMS=

# --- Agendamento ---
# Calendly é o padrão. Cal.com saiu da stack (DECISOES.md, seção 2);
# se .env.calcom ainda existir no repositório, é resíduo a remover.
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SECRET=
